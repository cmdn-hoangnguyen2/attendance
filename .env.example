# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Storage Bucket Name
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=payment-images

# Reset safety: set explicitly in the process running the reset command.
# Remote reset requires exact matching linked/URL/development references,
# plus a production project reference to exclude. If there is no production
# project, explicitly use the literal "none" after confirming that fact.
# Blank/missing values are never treated as "no production".
APP_ENVIRONMENT=
DEV_RESET_PROJECT_REF=
PRODUCTION_PROJECT_REF=
# DEV_RESET_ACKNOWLEDGEMENT is process-only; do not save it in env files.

# Dedicated disposable integration database (never the product development DB).
CMDN_TEST_ENVIRONMENT=
CMDN_TEST_SUPABASE_URL=
CMDN_TEST_SUPABASE_PROJECT_REF=
CMDN_TEST_SUPABASE_SERVICE_ROLE_KEY=
CMDN_TEST_SUPABASE_ANON_KEY=
CMDN_PRODUCTION_SUPABASE_PROJECT_REF=

# HTTP contracts use real Auth0 sessions in a dedicated test origin.
CMDN_CONTRACT_BASE_URL=
CMDN_CONTRACT_DEDICATED_ORIGIN=
CMDN_PRODUCTION_APP_ORIGIN=
# CMDN_CONTRACT_MEMBER_COOKIE, CMDN_CONTRACT_OWNER_COOKIE and
# CMDN_CONTRACT_ADMIN_COOKIE are process-only; never save or log them.

# AUTH0
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# 64 character random string to encrypt the session cookie
#
# We're generating a secret for your convenience, but for production,
# generate your own secret using `openssl rand -hex 32`
AUTH0_SECRET=

# Auth Mode Toggle: set "true" for local mock testing without Auth0, "false" for real Auth0
NEXT_PUBLIC_ALLOW_MOCK_AUTH=false

# Optional Auth0 Connection (bypasses Auth0 login screen to go directly to Google Account Chooser)
AUTH0_CONNECTION=google-oauth2
