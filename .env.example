# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Storage Bucket Name
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=payment-images

# AUTH0
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# 64 character random string to encrypt the session cookie
#
# We're generating a secret for your convenience, but for production,
# generate your own secret using `openssl rand -hex 32`
AUTH0_SECRET=

# Auth Mode Toggle: set "true" for local mock testing without Auth0, "false" for real Auth0
NEXT_PUBLIC_ALLOW_MOCK_AUTH=false

# Optional Auth0 Connection (bypasses Auth0 login screen to go directly to Google Account Chooser)
AUTH0_CONNECTION=google-oauth2
